<?xml version="1.0" encoding="UTF-8"?>
<interface domain="io.github.sifenfisaha.Salah">
  <requires lib="gtk" version="4.14"/>
  <requires lib="libadwaita" version="1.6"/>

  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Play the Adhan</attribute>
        <attribute name="action">app.play</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Stop the Adhan</attribute>
        <attribute name="action">app.stop</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Location…</attribute>
        <attribute name="action">app.location</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Salah</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>

  <template class="SalahWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Salah</property>
    <property name="default-width">440</property>
    <property name="default-height">780</property>
    <property name="width-request">360</property>
    <property name="height-request">420</property>

    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 430sp</condition>
        <setter object="hero_card" property="orientation">vertical</setter>
        <setter object="hero_text" property="halign">center</setter>
        <setter object="time_box" property="halign">center</setter>
        <setter object="next_caption" property="xalign">0.5</setter>
        <setter object="remaining" property="xalign">0.5</setter>
      </object>
    </child>

    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">
            <property name="top-bar-style">flat</property>
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-title">false</property>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <property name="primary">true</property>
                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="AdwBanner" id="banner">
                    <property name="title" translatable="yes">The adhan is playing</property>
                    <property name="button-label" translatable="yes">Stop</property>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="stack">
                    <property name="transition-type">crossfade</property>
                    <property name="vexpand">true</property>

                    <child>
                      <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">salah-mosque-symbolic</property>
                            <property name="title" translatable="yes">Set a Location</property>
                            <property name="description" translatable="yes">Prayer times are computed for where you are, on this device. Nothing about you is sent anywhere.</property>
                            <property name="child">
                              <object class="GtkButton">
                                <property name="label" translatable="yes">Choose a Location…</property>
                                <property name="action-name">app.location</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkStackPage">
                        <property name="name">day</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="propagate-natural-height">true</property>
                            <property name="child">
                              <object class="AdwClamp">
                                <property name="maximum-size">560</property>
                                <property name="tightening-threshold">440</property>
                                <property name="margin-start">14</property>
                                <property name="margin-end">14</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">18</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">18</property>

                                    <!-- The hero: the ring, what is next, and how long is left. -->
                                    <child>
                                      <object class="GtkBox" id="hero_card">
                                        <property name="spacing">20</property>
                                        <style>
                                          <class name="card"/>
                                          <class name="hero"/>
                                        </style>
                                        <child>
                                          <object class="GtkOverlay">
                                            <property name="halign">center</property>
                                            <property name="valign">center</property>
                                            <property name="child">
                                              <object class="SalahRing" id="ring">
                                                <property name="size">104</property>
                                                <property name="line-width">7</property>
                                              </object>
                                            </property>
                                            <child type="overlay">
                                              <object class="GtkImage" id="ring_icon">
                                                <property name="icon-name">salah-mosque-symbolic</property>
                                                <property name="pixel-size">40</property>
                                                <property name="halign">center</property>
                                                <property name="valign">center</property>
                                                <property name="can-target">false</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="hero_text">
                                            <property name="orientation">vertical</property>
                                            <property name="valign">center</property>
                                            <property name="hexpand">true</property>
                                            <property name="spacing">2</property>
                                            <child>
                                              <object class="GtkLabel" id="next_caption">
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="caption-heading"/>
                                                  <class name="dim-label"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkBox" id="time_box">
                                                <property name="spacing">10</property>
                                                <child>
                                                  <object class="GtkLabel" id="next_time">
                                                    <property name="xalign">0</property>
                                                    <property name="label">--:--</property>
                                                    <style>
                                                      <class name="hero-time"/>
                                                      <class name="numeric"/>
                                                    </style>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkLabel" id="next_arabic">
                                                    <property name="valign">end</property>
                                                    <style>
                                                      <class name="hero-arabic"/>
                                                    </style>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="remaining">
                                                <property name="xalign">0</property>
                                                <style>
                                                  <class name="hero-remaining"/>
                                                  <class name="accent"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- The Hijri date. -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="halign">center</property>
                                        <property name="spacing">8</property>
                                        <style>
                                          <class name="hijri"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="icon-name">salah-calendar-symbolic</property>
                                            <style>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="hijri_label">
                                            <style>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="hijri_note">
                                            <property name="visible">false</property>
                                            <style>
                                              <class name="accent"/>
                                              <class name="heading"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- The six rows. -->
                                    <child>
                                      <object class="GtkListBox" id="prayer_list">
                                        <property name="selection-mode">none</property>
                                        <style>
                                          <class name="boxed-list"/>
                                          <class name="prayers"/>
                                        </style>
                                      </object>
                                    </child>

                                    <!-- The derived times. -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <property name="label" translatable="yes">Also today</property>
                                            <property name="xalign">0</property>
                                            <style>
                                              <class name="heading"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkFlowBox" id="derived_box">
                                            <property name="selection-mode">none</property>
                                            <property name="homogeneous">true</property>
                                            <property name="min-children-per-line">2</property>
                                            <property name="max-children-per-line">3</property>
                                            <property name="column-spacing">10</property>
                                            <property name="row-spacing">10</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                    <!-- Where and how. -->
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">app.location</property>
                                            <property name="tooltip-text" translatable="yes">Change the location</property>
                                            <property name="hexpand">true</property>
                                            <property name="halign">start</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="footer-button"/>
                                            </style>
                                            <property name="child">
                                              <object class="GtkBox">
                                                <property name="spacing">10</property>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">mark-location-symbolic</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkBox">
                                                    <property name="orientation">vertical</property>
                                                    <child>
                                                      <object class="GtkLabel" id="location_label">
                                                        <property name="xalign">0</property>
                                                        <property name="ellipsize">end</property>
                                                      </object>
                                                    </child>
                                                    <child>
                                                      <object class="GtkLabel" id="method_label">
                                                        <property name="xalign">0</property>
                                                        <property name="ellipsize">end</property>
                                                        <style>
                                                          <class name="caption"/>
                                                          <class name="dim-label"/>
                                                        </style>
                                                      </object>
                                                    </child>
                                                  </object>
                                                </child>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="action-name">app.preferences</property>
                                            <property name="icon-name">emblem-system-symbolic</property>
                                            <property name="valign">center</property>
                                            <property name="tooltip-text" translatable="yes">Preferences</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>

                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
